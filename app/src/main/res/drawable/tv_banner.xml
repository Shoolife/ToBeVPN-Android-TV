<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#FF102436"
                android:startColor="#FF07141F" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item
        android:bottom="24dp"
        android:left="28dp"
        android:right="188dp"
        android:top="24dp"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>
